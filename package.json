{
	"name": "cf-honeypot-html-identifier",
	"version": "0.1.0",
	"private": true,
	"description": "Educational MVP: Cloudflare Worker that embeds a sealed, hidden identifier in HTML to attribute scraped copies, discover clones and build approval-gated evidence.",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "npm run db:migrate:remote && wrangler deploy",
		"types": "wrangler types --strict-vars=false",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"hp": "node scripts/hp.mjs"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.9.1",
		"typescript": "^7.0.2",
		"vitest": "^5.1.1",
		"wrangler": "^4.167.0"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"workerd@1.20261123.1": true
	}
}
