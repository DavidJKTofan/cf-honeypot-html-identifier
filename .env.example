# Wrangler system environment variables (copy to .env, which is gitignored).
# https://developers.cloudflare.com/workers/wrangler/system-environment-variables/
CLOUDFLARE_ACCOUNT_ID=<your-cloudflare-account-id>

# Admin CLI (scripts/hp.mjs) only: Cloudflare Access service token for ADMIN_PREFIX.
# Keep it here, NOT in .dev.vars (`wrangler deploy --secrets-file .dev.vars` would upload it).
# HP_ACCESS_CLIENT_ID="<client-id>.access"
# HP_ACCESS_CLIENT_SECRET="<client-secret>"
